{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "buildCommand": "npm run build",
  "installCommand": "npm install --legacy-peer-deps",
  "rewrites": [
    {
      "source": "/api/railway/:path*",
      "destination": "/api/railway-proxy?path=:path*"
    },
    { "source": "/", "destination": "/api" },
    {
      "source": "/((?!api/railway-proxy|api/railway).*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.mjs": {
      "includeFiles": "dist/robotech-frontend/**"
    }
  }
}
